# Copy to `.env` and adjust. Consumed by @devmentor/core (app runtime) and the
# MikroORM CLI (@devmentor/db). Never commit the real `.env`.

# --- App ---
NODE_ENV=development
APP_NAME=DevMentor
LOG_LEVEL=info
# Public base URL, used for OAuth callbacks and links in email. Default shown.
# APP_URL=http://localhost:3000

# --- Database ---
# Either set DATABASE_URL (takes precedence) ...
# DATABASE_URL=postgres://devmentor:devmentor@127.0.0.1:5432/devmentor
# ... or the discrete DB_* vars below. Defaults match docker-compose.yml.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=devmentor
DB_USER=devmentor
DB_PASSWORD=devmentor

# --- Connection pool ---
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_MS=30000

# Set to "true" to log SQL.
DB_DEBUG=false

# --- Sessions and sign-in ---
# Every variable below is optional at boot; uncomment the ones you need.
# SESSION_SECRET signs session cookies (at least 32 characters). Production refuses to
# serve without it; without it in development, sign-in routes fail closed. Generate:
#   openssl rand -base64 48
# SESSION_SECRET=
# Previous secret, still accepted for verification during a rotation.
# SESSION_SECRET_PREVIOUS=
# GitHub OAuth app credentials. When unset, GitHub sign-in fails closed.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Comma-separated operator allowlist; trimmed and case-insensitive. Default: empty.
# OPERATOR_EMAILS=you@example.com
# Reverse proxies in front of the app whose X-Forwarded-For entries are trusted.
# TRUSTED_PROXY_HOPS=0
# Password hashes computed at once (each scrypt hash uses ~128 MiB), and how long a
# sign-in waits for a free slot before answering 503.
# PASSWORD_HASH_CONCURRENCY=4
# PASSWORD_HASH_WAIT_MS=5000

# --- Email (Resend) ---
# Production requires MAIL_API_KEY and MAIL_FROM (a sender on a Resend-verified domain).
# With MAILER_ADAPTER unset and no MAIL_API_KEY in development, mail is written to the
# log instead of sent, with a warning at boot. Elsewhere a missing key or sender makes
# every send fail with 503.
# MAILER_ADAPTER=resend
# MAIL_API_KEY=
# MAIL_FROM=DevMentor <hello@example.com>

# --- Test adapters (integration runs only) ---
# AUTH_IDENTITY_ADAPTER=mock and MAILER_ADAPTER=log are refused at boot unless
# INTEGRATION_TEST_RUN=1 is also set. Never set these outside the test harness.
# AUTH_IDENTITY_ADAPTER=github
# INTEGRATION_TEST_RUN=0
