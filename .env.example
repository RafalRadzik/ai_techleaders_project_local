# Copy to `.env` (git-ignored) and adjust. Read by Next.js (packages/app/next.config.ts),
# the MikroORM CLI (packages/db/src/mikro-orm.config.ts) and docker compose.
# Never put real secrets in this file.

# --- Local PostgreSQL (docker-compose.yml) ---
POSTGRES_USER=devmentor
POSTGRES_PASSWORD=devmentor
POSTGRES_DB=devmentor
POSTGRES_PORT=5432

# --- MikroORM ---
DATABASE_URL=postgresql://devmentor:devmentor@localhost:5432/devmentor
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
MIKRO_ORM_DEBUG=false
