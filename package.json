{
  "name": "devmentor",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=22.17.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup": "node packages/config/bin/setup.mjs",
    "dev": "npm run dev -w @devmentor/app",
    "build": "npm run build -w @devmentor/app",
    "start": "npm run start -w @devmentor/app",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "npm run test:integration -w @devmentor/integration",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migration:create": "npm run migration:create -w @devmentor/db --",
    "db:migrate": "npm run migration:up -w @devmentor/db",
    "db:migrate:down": "npm run migration:down -w @devmentor/db",
    "db:migration:list": "npm run migration:list -w @devmentor/db"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^9",
    "typescript": "^5",
    "vitest": "^5.0.4"
  }
}
